# Normalise line endings so the repo is identical on every machine.
* text=auto eol=lf

# Binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.p8 binary
*.p12 binary
*.jks binary
*.keystore binary

# Lockfile: keep diffs quiet in review but always take ours on conflict-by-rerun
package-lock.json linguist-generated=true
